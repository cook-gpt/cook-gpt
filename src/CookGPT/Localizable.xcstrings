    "Plan meals, cook with step timers, and shop smarter — all on your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan meals, cook with step timers, and shop smarter — all on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica comidas, cocina con temporizadores y compra mejor — todo en tu dispositivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica àpats, cuina amb temporitzadors i compra millor — tot al teu dispositiu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez vos repas, cuisinez avec des minuteurs et faites vos courses plus intelligemment — sur votre appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan maaltijden, kook met stap-timers en shop slimmer — allemaal op je apparaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane Mahlzeiten, koche mit Schritt-Timern und shoppe smarter — alles auf deinem Gerät."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划餐食、使用步骤计时器烹饪、更聪明地购物——全部在您的设备上完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事の計画、ステップタイマーでの調理、スマートな買い物 — すべてデバイス上で。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica pasti, cucina con timer per passaggi e fai la spesa in modo più intelligente — tutto sul dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeie refeições, cozinhe com temporizadores e faça compras mais inteligentes — tudo no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планируйте питание, готовьте с пошаговыми таймерами и покупайте умнее — всё на вашем устройстве."
          }
        }
      }
    },
