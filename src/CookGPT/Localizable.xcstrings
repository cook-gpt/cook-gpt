    "Pick the collections you want. We only add categories and recipes you select.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the collections you want. We only add categories and recipes you select."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las colecciones que quieras. Solo añadimos las categorías y recetas que selecciones."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria les col·leccions que vulguis. Només afegim categories i receptes que selecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les collections souhaitées. Nous ajoutons uniquement les catégories et recettes sélectionnées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de collecties die je wilt. We voegen alleen geselecteerde categorieën en recepten toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sammlungen, die du möchtest. Wir fügen nur ausgewählte Kategorien und Rezepte hinzu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您想要的合集。我们仅添加您选择的分类和食谱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欲しいコレクションを選んでください。選択したカテゴリとレシピのみ追加します。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le raccolte che vuoi. Aggiungiamo solo categorie e ricette selezionate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as coleções que deseja. Só adicionamos categorias e receitas selecionadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите нужные коллекции. Мы добавляем только выбранные категории и рецепты."
          }
        }
      }
    },
