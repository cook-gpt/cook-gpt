    "This will permanently delete all recipes, scheduled meals, groceries, timers, and custom settings, then restore default data. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete all recipes, scheduled meals, groceries, timers, and custom settings, then restore default data. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente todas las recetas, comidas programadas, compras, temporizadores y ajustes personalizados, y restaurará los datos predeterminados. No se puede deshacer."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això eliminarà permanentment totes les receptes, àpats programats, compres, temporitzadors i ajustos personalitzats, i restaurarà les dades predeterminades. No es pot desfer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement toutes les recettes, repas programmés, courses, minuteurs et paramètres personnalisés, puis restaurera les données par défaut. Action irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert permanent alle recepten, geplande maaltijden, boodschappen, timers en aangepaste instellingen en herstelt standaardgegevens. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht dauerhaft alle Rezepte, geplanten Mahlzeiten, Einkäufe, Timer und benutzerdefinierten Einstellungen und stellt Standarddaten wieder her. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有食谱、计划餐食、购物清单、计时器和自定义设置，然后恢复默认数据。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのレシピ、予定食、買い物、タイマー、カスタム設定を完全に削除し、デフォルトデータを復元します。元に戻せません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo eliminerà definitivamente tutte le ricette, i pasti programmati, la spesa, i timer e le impostazioni personalizzate, quindi ripristinerà i dati predefiniti. Operazione irreversibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto eliminará permanentemente todas as receitas, refeições agendadas, compras, temporizadores e definições personalizadas e restaurará os dados padrão. Não pode ser anulado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все рецепты, запланированные приёмы пищи, покупки, таймеры и пользовательские настройки, затем восстановит данные по умолчанию. Отменить нельзя."
          }
        }
      }
    },
