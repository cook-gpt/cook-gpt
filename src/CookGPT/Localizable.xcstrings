    "Deletes all recipes, meals, groceries, timers, and custom settings, then shows the first-launch walkthrough again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all recipes, meals, groceries, timers, and custom settings, then shows the first-launch walkthrough again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las recetas, comidas, compras, temporizadores y ajustes personalizados, y muestra de nuevo el tutorial inicial."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina totes les receptes, àpats, compres, temporitzadors i ajustos personalitzats, i mostra de nou el tutorial inicial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les recettes, repas, courses, minuteurs et paramètres personnalisés, puis affiche à nouveau le tutoriel initial."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alle recepten, maaltijden, boodschappen, timers en aangepaste instellingen en toont de eerste-start rondleiding opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Rezepte, Mahlzeiten, Einkäufe, Timer und benutzerdefinierten Einstellungen und zeigt die Ersteinrichtung erneut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有食谱、餐食、购物清单、计时器和自定义设置，然后再次显示首次启动教程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのレシピ、食事、買い物、タイマー、カスタム設定を削除し、初回チュートリアルを再表示します。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le ricette, i pasti, la spesa, i timer e le impostazioni personalizzate, poi mostra di nuovo il tutorial iniziale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas as receitas, refeições, compras, temporizadores e definições personalizadas e mostra novamente o tutorial inicial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все рецепты, приёмы пищи, покупки, таймеры и пользовательские настройки, затем снова показывает обучение."
          }
        }
      }
    },
