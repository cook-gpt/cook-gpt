    "A default list is created on first launch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A default list is created on first launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea una lista predeterminada en el primer inicio."
          }
        },
        "ca": {
          "stringUnit": {
