    "Additional pro features are planned for a future update. The current version is free and includes no in-app purchases or subscriptions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional pro features are planned for a future update. The current version is free and includes no in-app purchases or subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se planean funciones Pro en una futura actualización. La versión actual es gratuita y no incluye compras ni suscripciones."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es preveuen funcions Pro en una futura actualització. La versió actual és gratuïta i no inclou compres ni subscripcions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fonctionnalités Pro sont prévues dans une future mise à jour. La version actuelle est gratuite sans achats ni abonnements."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra Pro-functies zijn gepland voor een toekomstige update. De huidige versie is gratis zonder aankopen of abonnementen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Pro-Funktionen sind für ein zukünftiges Update geplant. Die aktuelle Version ist kostenlos ohne Käufe oder Abonnements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多 Pro 功能将在未来更新中推出。当前版本免费，不含应用内购买或订阅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加のPro機能は将来の更新で予定されています。現在のバージョンは無料で、アプリ内購入やサブスクリプションはありません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulteriori funzioni Pro sono previste in un aggiornamento futuro. La versione attuale è gratuita senza acquisti o abbonamenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionalidades Pro adicionais estão planeadas para uma atualização futura. A versão atual é gratuita sem compras ou subscrições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные Pro-функции запланированы в будущем обновлении. Текущая версия бесплатна, без покупок и подписок."
          }
        }
      }
    },
