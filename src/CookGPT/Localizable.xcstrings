    "Used when navigating weeks on the Meals page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when navigating weeks on the Meals page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al navegar por semanas en la página Comidas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'utilitza en navegar per setmanes a la pàgina Àpats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lors de la navigation par semaines sur la page Repas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt bij het navigeren door weken op de pagina Maaltijden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Navigieren durch Wochen auf der Seite Mahlzeiten verwendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在餐食页面按周浏览。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事ページで週を移動する際に使用されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per navigare le settimane nella pagina Pasti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado ao navegar pelas semanas na página Refeições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при навигации по неделям на странице «Приёмы пищи»."
          }
        }
      }
    },
    "Used when planning meals and as the default for new scheduled meals.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when planning meals and as the default for new scheduled meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al planificar comidas y como predeterminado para nuevas comidas programadas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'utilitza en planificar àpats i com predeterminat per nous àpats programats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lors de la planification des repas et par défaut pour les nouveaux repas programmés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt bij het plannen van maaltijden en als standaard voor nieuwe geplande maaltijden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei der Essensplanung und als Standard für neue geplante Mahlzeiten verwendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于餐食规划，并作为新计划餐食的默认值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事の計画時および新しい予定食のデフォルトとして使用されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per pianificare i pasti e come predefinito per i nuovi pasti programmati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado ao planear refeições e como padrão para novas refeições agendadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при планировании питания и как значение по умолчанию для новых запланированных приёмов пищи."
          }
        }
      }
    },
    "Uses the same alarm names as the iPhone Clock app. Previews and timer audio require a physical device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the same alarm names as the iPhone Clock app. Previews and timer audio require a physical device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los mismos nombres de alarma que la app Reloj del iPhone. Las vistas previas y el audio requieren un dispositivo físico."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza els mateixos noms d'alarma que l'app Rellotge de l'iPhone. Les previsualitzacions i l'àudio requereixen un dispositiu físic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les mêmes noms d'alarme que l'app Horloge de l'iPhone. Les aperçus et l'audio nécessitent un appareil physique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt dezelfde alarmnamen als de Klok-app op iPhone. Voorbeelden en audio vereisen een fysiek apparaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet dieselben Alarmnamen wie die iPhone-Uhren-App. Vorschauen und Audio erfordern ein physisches Gerät."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与 iPhone 时钟应用相同的闹钟名称。预览和计时器音频需要实体设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの時計アプリと同じアラーム名を使用します。プレビューとタイマー音声には実機が必要です。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa gli stessi nomi degli allarmi dell'app Orologio di iPhone. Anteprime e audio richiedono un dispositivo fisico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa os mesmos nomes de alarme da app Relógio do iPhone. Pré-visualizações e áudio exigem um dispositivo físico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует те же названия будильников, что и приложение «Часы» на iPhone. Предпросмотр и звук требуют физического устройства."
          }
        }
      }
    },
