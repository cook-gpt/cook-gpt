    "Only one lunch or dinner recipe is available for this diet type, so choose lunch or dinner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one lunch or dinner recipe is available for this diet type, so choose lunch or dinner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay una receta de almuerzo o cena para este tipo de dieta; elige almuerzo o cena."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només hi ha una recepta de dinar o sopar per aquest tipus de dieta; tria dinar o sopar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule recette de déjeuner ou dîner est disponible pour ce régime ; choisissez déjeuner ou dîner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is slechts één lunch- of dinerrecept voor dit dieettype; kies lunch of diner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Ernährungstyp ist nur ein Mittags- oder Abendessen-Rezept verfügbar; wähle Mittagessen oder Abendessen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此饮食类型仅有一个午餐或晚餐食谱，请选择午餐或晚餐。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食事タイプでは昼食または夕食のレシピが1つだけです。どちらかを選んでください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo tipo di dieta è disponibile una sola ricetta per pranzo o cena; scegli pranzo o cena."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só há uma receita de almoço ou jantar para este tipo de dieta; escolha almoço ou jantar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого типа питания доступен только один рецепт на обед или ужин — выберите обед или ужин."
          }
        }
      }
    },
