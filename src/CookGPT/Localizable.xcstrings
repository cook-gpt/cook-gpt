    "Add at least one recipe to breakfast category to allow breakfast planning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one recipe to breakfast category to allow breakfast planning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos una receta a la categoría Desayuno para planificar desayunos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix almenys una recepta a la categoria Esmorzar per planificar esmorzars."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins une recette à la catégorie Petit-déjeuner pour planifier les petits-déjeuners."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg minstens één recept toe aan de categorie Ontbijt om ontbijtplanning mogelijk te maken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mindestens ein Rezept zur Kategorie Frühstück hinzu, um Frühstücksplanung zu ermöglichen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少添加一个早餐分类的食谱才能规划早餐。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝食の計画には、朝食カテゴリに少なくとも1つのレシピを追加してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi almeno una ricetta alla categoria Colazione per pianificare la colazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pelo menos uma receita à categoria Pequeno-almoço para planear o pequeno-almoço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы один рецепт в категорию «Завтрак», чтобы планировать завтрак."
          }
        }
      }
    },
